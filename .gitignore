# ============================================================
# .gitignore - Files to exclude from version control
# NEVER commit credentials, secrets, or build artifacts
# ============================================================

# Environment Variables (MOST IMPORTANT - never commit!)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React Build
frontend/build/
frontend/.eslintcache

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Docker
.docker/

# Coverage
coverage/
.nyc_output/
